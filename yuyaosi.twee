:: StoryTitle
玉瑶司 · 问心寻解

:: StoryData
{"ifid":"7C08B946-4A9F-47E2-BF18-CA56AB679C41","format":"SugarCube","format-version":"2.37.3","start":"Start"}

:: StoryStylesheet [stylesheet]
:root{--ink:#15352e;--deep:#102820;--gold:#a88752;--paper:#f8f5ed;--cream:#ede7d8;--line:#dcd4c3;--muted:#67776c}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.8 -apple-system,BlinkMacSystemFont,'Noto Serif SC','Songti SC','Microsoft Yahei',serif}button,input{font:inherit}button{cursor:pointer;border:0;background:none;color:inherit}button:focus-visible,input:focus-visible{outline:2px solid var(--gold);outline-offset:3px}.shell{min-height:100vh;display:flex;flex-direction:column}.top{display:flex;align-items:center;justify-content:space-between;padding:19px max(5vw,20px);border-bottom:1px solid var(--line);background:#fbf9f4}.brand{font-weight:700;letter-spacing:.18em;font-size:22px}.brand span{font-weight:400;letter-spacing:.05em;font-size:13px;color:var(--muted)}nav{display:flex;gap:22px}nav button{font-size:13px;color:#47665a}main{flex:1;width:min(1120px,92%);margin:0 auto}footer{text-align:center;color:#7c887e;border-top:1px solid var(--line);padding:24px;font-size:12px}.hero{min-height:75vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;position:relative;padding:55px 0 70px}.hero:before{content:'';position:absolute;inset:4% 15%;border:1px solid #d9cfb8;border-radius:50% 50% 3% 3%;pointer-events:none;opacity:.5}.seal{background:var(--deep);color:#d9bf84;border:1px solid #b69a60;outline:5px solid var(--deep);width:56px;height:74px;line-height:1.5;padding-top:8px;margin-bottom:40px;font-size:21px;letter-spacing:.1em}.eyebrow{color:var(--gold);font-size:12px;letter-spacing:.35em;font-weight:600}.hero h1{font-size:clamp(38px,6vw,76px);line-height:1.5;font-weight:500;letter-spacing:.14em;margin:8px 0 12px}.hero h1 em{font-style:normal;color:#8c784e}.hero p:not(.eyebrow){color:#68786c}.primary{background:var(--deep);color:#f7f1df;padding:14px 35px;border:1px solid var(--deep);transition:.2s;display:inline-block;margin-top:20px}.primary:hover{background:#285044;transform:translateY(-2px)}.primary span{margin-left:30px;color:#d7c29b}.home-links{display:flex;gap:24px;margin-top:40px;flex-wrap:wrap;justify-content:center}.home-links button,.subactions button{color:#5d7466;text-decoration:underline;text-underline-offset:6px;font-size:13px}.explore-layout{display:grid;grid-template-columns:260px 1fr;gap:70px;padding:75px 0}.path{border-right:1px solid var(--line);padding-right:28px}.path-title{font-size:12px;color:var(--gold);letter-spacing:.2em}.nodes{display:flex;flex-direction:column;align-items:flex-start;margin-top:20px}.node{padding:12px 14px;border:1px solid var(--line);background:#f4efe5;text-align:left;width:100%;font-size:13px;line-height:1.6;transition:.2s}.node small{display:block;color:#8c7d62}.node.active{border-color:var(--gold);background:#e9e0cb}.node.done{background:#e8eee8;border-color:#b4c9b9}.connector{padding-left:20px;color:var(--gold)}.question{max-width:680px;animation:appear .35s ease}.question h2,.page-head h2{font-size:clamp(26px,4vw,40px);font-weight:500;letter-spacing:.05em;line-height:1.45;margin:14px 0}.muted{color:var(--muted)}.choices{display:grid;gap:12px;margin:38px 0 25px}.choice{display:flex;align-items:center;justify-content:space-between;text-align:left;background:#fffdf8;border:1px solid var(--line);padding:15px 20px;min-height:60px;transition:.2s}.choice:hover{border-color:var(--gold);background:#f0eadc;transform:translateX(4px)}.choice span{color:var(--gold)}.subactions{display:flex;gap:25px;flex-wrap:wrap}.page-head{padding:65px 0 35px;border-bottom:1px solid var(--line)}.result-grid{display:grid;grid-template-columns:280px 1fr;gap:35px;margin:36px 0 65px}.summary,.detail{background:#fffdf8;border:1px solid var(--line);padding:25px}.summary{align-self:start;position:sticky;top:15px}.summary h3{font-size:18px;font-weight:500}.summary button{display:block;text-decoration:underline;color:#3f6757;margin-top:12px;font-size:13px}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;color:#4b6255}.results{display:grid;gap:20px}.card{background:#fffdf8;border:1px solid var(--line);padding:25px;min-width:0}.card-top{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}.chip,.tag{font-size:12px;color:#7c785e}.tag{border:1px solid #b9a67d;padding:0 8px}.card h3{font-weight:500;font-size:23px;margin:10px 0}.price{font-size:19px;color:#a0793c;font-weight:600;overflow-wrap:anywhere}.card p{color:#53675b;overflow-wrap:anywhere}.card .reason{border-left:2px solid var(--gold);padding-left:12px;color:#365b4b}.fine{font-size:12px!important;color:#839084!important}.actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:18px}.actions button,.filters button,.comparebar button,.detail button:not(.primary),.empty button{padding:7px 12px;border:1px solid #c7c7b5;font-size:13px}.actions button:hover,.filters button:hover{border-color:var(--gold)}.actions .outline{background:#e9eee8;border-color:#b8c9bc}.toolbar{display:flex;gap:18px;align-items:center;justify-content:space-between;margin:30px 0;flex-wrap:wrap}input[type=search]{background:#fffdf8;border:1px solid var(--line);padding:12px 14px;width:min(360px,100%);border-radius:0}.filters{display:flex;gap:7px;flex-wrap:wrap}.filters .selected{background:var(--deep);color:white}.count{color:var(--muted);font-size:13px}.catalog-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-bottom:65px}.detail{margin:30px auto 75px;max-width:760px}.detail-row{border-bottom:1px solid var(--line);padding:12px 0}.detail-row b{font-size:13px;color:#8d7957}.detail-row p{margin:4px 0}.empty{padding:40px;border:1px dashed #c5bba8}.comparebar{position:sticky;bottom:10px;background:var(--deep);color:#fff;padding:12px 18px;display:flex;align-items:center;gap:15px;justify-content:center;z-index:3}.comparebar button{color:white}.comparison{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;margin:30px 0}.qr{max-width:220px}.hero,.page-head{animation:appear .5s ease}@keyframes appear{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:translateY(0)}}@media(max-width:760px){.top{flex-direction:column;gap:8px;padding:12px}.brand{font-size:19px}nav{gap:15px}.hero{min-height:70vh}.hero:before{inset:7% 1%}.explore-layout,.result-grid{grid-template-columns:1fr;gap:20px;padding-top:20px}.path{border-right:0;border-bottom:1px solid var(--line);padding:0 0 18px}.nodes{margin-top:8px;flex-direction:row;overflow-x:auto;align-items:center;gap:6px}.node{min-width:115px;width:auto;max-width:170px;padding:8px;font-size:11px;flex-shrink:0}.connector{padding:0;transform:rotate(-90deg)}.question{padding:12px 0 30px}.catalog-grid{grid-template-columns:1fr}.summary{position:static}.page-head{padding:35px 0 20px}.card{padding:19px}.home-links{gap:14px}.home-links button{font-size:12px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
/* v2 additions */
.catalog-tree{margin:28px 0 55px}.catalog-cat{margin:13px 0;border:1px solid var(--line);background:#fffdf8}.cat-heading,.sub-heading{width:100%;display:flex;align-items:center;justify-content:space-between;text-align:left;padding:17px 22px;font-size:20px}.cat-heading{background:#edf0e8}.cat-heading small,.sub-heading small{font-size:12px;color:var(--muted);font-weight:400}.subgroups{padding:10px 20px 20px}.subgroup{border-bottom:1px solid var(--line)}.sub-heading{font-size:16px;padding:14px 9px}.products{padding:3px 0 15px}.product-row{width:100%;display:flex;align-items:center;justify-content:space-between;text-align:left;gap:20px;padding:13px 15px;border-bottom:1px solid #ece6d9;background:#fff}.product-row:hover{background:#f3eee2}.product-row b{font-size:14px;color:#a0793c;font-weight:500;text-align:right;max-width:48%;overflow-wrap:anywhere}.product-row small{font-size:12px;color:var(--muted)}.bottom{margin:25px 0 55px}.comparison .card p{overflow-wrap:anywhere}.detail-row p{white-space:pre-line}.hero h1{letter-spacing:.08em}@media(max-width:760px){.cat-heading{font-size:18px}.subgroups{padding:6px 10px 14px}.product-row{padding:13px 7px;font-size:14px}.product-row b{font-size:12px}.nodes{flex-direction:column;overflow:visible;align-items:stretch}.node{width:100%;max-width:none}.connector{transform:none;padding-left:15px;line-height:12px}}

/* V3: 首页对联、三字竖匾、移动端全屏视觉 */
.hero{min-height:calc(100svh - 170px);min-height:max(690px,calc(100svh - 170px));display:grid;grid-template-columns:minmax(36px,1fr) minmax(0,8fr) minmax(36px,1fr);align-items:stretch;gap:clamp(4px,1vw,20px);padding:26px 0 28px;isolation:isolate}
.hero:before{inset:5% 6%;z-index:-1}
.hero-center{grid-column:2;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:clamp(10px,2vh,22px);padding:16px 0}
.hero-side{writing-mode:vertical-rl;text-orientation:upright;white-space:nowrap;display:flex;align-items:center;justify-content:center;align-self:stretch;justify-self:center;font-size:clamp(25px,3.4vw,52px);font-weight:600;letter-spacing:.16em;line-height:1.1;color:var(--ink);font-family:'Kaiti SC','STKaiti','KaiTi','Songti SC',serif}
.hero-side-left{grid-column:1;grid-row:1}.hero-side-right{grid-column:3;grid-row:1}
.hero-center .seal{height:auto;min-height:125px;width:64px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:6px;padding:12px 0;margin:0;line-height:1.3}
.hero-center .seal span{display:block}
.hero-center .eyebrow{margin:8px 0 0}
.hero-center h1{font-size:clamp(32px,5.5vw,70px);margin:0;line-height:1.55;letter-spacing:.045em;white-space:nowrap}
.hero-center p:not(.eyebrow){margin:0;font-size:clamp(12px,1.6vw,17px)}
.hero-center .primary{margin-top:8px;min-width:min(300px,100%)}
.hero-center .home-links{margin-top:8px;gap:12px 22px}
@media(max-width:760px){
 .hero{width:100%;min-height:max(760px,calc(100svh - 165px));grid-template-columns:minmax(26px,13%) minmax(0,74%) minmax(26px,13%);gap:0;padding:15px 0 18px}
 .hero:before{inset:5% 1%}
 .hero-side{font-size:clamp(24px,6.8vw,39px);letter-spacing:.15em}
 .hero-center{gap:clamp(14px,2.5vh,26px);padding:16px 1px}
 .hero-center .seal{min-height:136px;width:58px;font-size:20px;gap:9px}
 .hero-center .eyebrow{font-size:10px;letter-spacing:.18em}
 .hero-center h1{font-size:clamp(27px,7.2vw,43px);letter-spacing:0;line-height:1.75}
 .hero-center p:not(.eyebrow){font-size:clamp(11px,3.1vw,15px);line-height:2}
 .hero-center .primary{min-width:0;width:90%;padding:13px 8px}
 .hero-center .home-links{display:flex;flex-direction:column;align-items:center;gap:12px;margin-top:10px}
 .hero-center .home-links button{font-size:12px}
}
@media(max-width:370px){.hero-center h1{font-size:25px}.hero-side{font-size:23px}.hero-center .eyebrow{letter-spacing:.07em}}


:: StoryJavaScript [script]
(()=>{'use strict';
const P=window.YY_PRODUCTS||[],C=['实体类','食品类','咨询类','课程类','法会','开光'];
const ROOT=[['人生方向与决策','决策'],['事业、财运与学业','事业'],['姻缘、婚姻与人际','姻缘'],['求子与家庭','求子'],['健康与日常状态','健康关切'],['家宅、风水与平安','家宅'],['传统祈福与节庆','祈福'],['学习传统文化','学习'],['物品、茶饮与日常','食品'],['我有多个问题','多项'],['我不确定属于哪类','不确定']];
const SUB={
'决策':[['有一件具体事情难以决定','决策'],['对未来感到迷茫','成长'],['希望持续规划与成长','长期'],['想先了解自己的情况','咨询']],
'事业':[['工作发展、升迁与就业','事业'],['财运祈愿或补财库','财运'],['学习考试与文昌','学业'],['开业、交易等事项择日','择日']],
'姻缘':[['希望了解姻缘、感情发展','姻缘'],['婚姻合婚、婚期','婚姻'],['夫妻关系或人际困扰','人际'],['感情方面想进一步沟通','咨询']],
'求子':[['关注求子祈愿','求子'],['想聊子女、家庭关系','咨询'],['希望先了解传统祈福选项','祈福']],
'健康关切':[['疲乏、气短、精神不足','气虚'],['面色、干燥等状态关切','血虚'],['希望静心安神','静心'],['为自己或长辈祈福','平安'],['希望进一步沟通','咨询']],
'家宅':[['房屋风水情况','风水'],['入住、装修或选址','房屋'],['家宅平安祈愿','平安'],['开光、镇物、供香','开光'],['择日或迁居','择日']],
'祈福':[['日常平安祈福','平安'],['节庆法会','节庆'],['个人专项法会','个人法会'],['祖先祭祀相关','祖先祭祀'],['了解符箓形式','符箓']],
'学习':[['国学入门','国学'],['梅花易数、小六壬','术数'],['秘法、静心相关课程','秘法'],['想看看全部课程','学习']],
'食品':[['日常茶饮、礼盒','茶饮'],['修愈乐红瓶或蓝瓶','修愈乐'],['香囊、饰品或朱砂','实体物品'],['物品开光或供香','开光']],
'多项':[['事业与财运','事业'],['感情与家庭','姻缘'],['家宅与平安','家宅'],['方向与成长','成长'],['健康与日常','健康关切'],['其他组合，进一步沟通','咨询']],
'不确定':[['先梳理自己的问题','咨询'],['先看看传统祈福','祈福'],['先看看实体物品','实体物品'],['先了解服务图鉴','图鉴']]};
const FORM=[['分析、咨询或决策参考','咨询'],['传统祈福、法会或仪式','仪式'],['符箓、饰品等实体物品','物品'],['风水、择日或开光事务','事务'],['课程、知识或技能','学习'],['茶饮、食品或日常用品','食品'],['尚不确定','不限']];
const DETAILS={咨询:[['有明确问题，简短咨询','明确'],['希望全面了解与深入梳理','深入'],['需要长期跟进','长期'],['暂不确定','不限']],仪式:[['日常祈福','祈福'],['节庆法会','法会'],['个人专项定制','个人法会'],['暂不确定','不限']],物品:[['符箓（各种形式）','符箓'],['饰品、朱砂、香囊','实体物品'],['希望了解开光','开光'],['暂不确定','不限']],事务:[['房屋风水','风水'],['择日或合婚','择日'],['开光、供香','开光'],['暂不确定','不限']],学习:[['国学基础','国学'],['术数学习','术数'],['秘法课程','秘法'],['暂不确定','不限']],食品:[['修愈乐','修愈乐'],['茶叶礼盒','茶饮'],['香囊或朱砂','实体物品'],['暂不确定','不限']],不限:[['先看可能的选择','不限'],['希望深入沟通','咨询']]};
const STAGES=['关注方向','具体困扰','希望的帮助','进一步偏好'];
let S={view:'home',answers:[],step:0,category:null,sub:null,query:'',detail:null,compare:[],from:'catalog',multi:[]};
const $=q=>document.querySelector(q),escape=x=>String(x??'待补充').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function persist(){try{sessionStorage.setItem('yy_v2',JSON.stringify(S))}catch{}}
function view(v){S.view=v;render()}function start(){S={...S,view:'explore',answers:[],step:0,multi:[]};render()}
function choose(v,l){S.answers=S.answers.slice(0,S.step);S.answers.push({value:v,label:l});S.step++;if(S.step>=4)S.view='results';render()}
function back(n){S.answers=S.answers.slice(0,n);S.step=n;view('explore')}
function header(body){$('#app').innerHTML=`<div class="shell"><header class="top"><button class="brand" data-act="home">玉瑶司 <small>· 问心寻解</small></button><nav><button data-act="explore">需求探索</button><button data-act="catalog">服务图鉴</button><button data-act="about">关于我们</button></nav></header><main>${body}</main><footer>玉瑶司 · 心有所惑，循迹而解。<br>本页面仅为服务信息导航，传统文化与祈福实践不保证现实结果，不能替代专业医疗、心理、法律或财务建议。探索选择仅存储于当前浏览器会话。</footer></div>`;bind()}
const button=(l,v)=>`<button class="choice" data-choice="${escape(v)}" data-label="${escape(l)}">${escape(l)}<span>↗</span></button>`;
function home(){header(`<section class="hero"><div class="hero-side hero-side-left" aria-label="无缘千金难求道">无缘千金难求道</div><div class="hero-side hero-side-right" aria-label="有缘分文不取收">有缘分文不取收</div><div class="hero-center"><div class="seal"><span>玉</span><span>瑶</span><span>司</span></div><p class="eyebrow">Y U · Y A O · S I</p><h1>念念不忘，<br><em>必有回响。</em></h1><p>每个人的困惑都有不同的来处。<br>让我们从你的问题开始。</p><button class="primary" data-act="start">开始探索　→</button><div class="home-links"><button data-act="catalog">直接查看全部服务</button><button data-act="unsure">我不知道自己需要什么</button><button data-act="about">了解玉瑶司</button></div></div></section>`)}
function path(){return `<aside class="path"><p class="eyebrow">探索之径 · 点击返回</p><div class="nodes"><button class="node ${S.step===0?'active':'done'}" data-back="0">起点</button>${S.answers.map((a,i)=>`<span class="connector">│</span><button class="node done" data-back="${i+1}"><small>${STAGES[i]}</small>${escape(a.label)}</button>`).join('')}</div></aside>`}
function explore(){let n=Math.min(S.step,3),opts=n===0?ROOT:n===1?(SUB[S.answers[0]?.value]||SUB['不确定']):n===2?FORM:(DETAILS[S.answers[2]?.value]||DETAILS['不限']);let title=['您目前最想了解什么？','哪一种情况更贴近您？','您希望获得怎样的帮助？','进一步了解您的偏好'][n];header(`<div class="explore-layout">${path()}<section class="question"><p class="eyebrow">第 ${n+1} / 4 步</p><h2>${title}</h2><p class="muted">选择最贴近您当前情况的一项；您可以随时返回修改。</p><div class="choices">${opts.map(([l,v])=>button(l,v)).join('')}</div><div class="subactions"><button data-act="results">先看看推荐</button><button data-act="restart">重新探索</button><button data-act="catalog">直接查看服务</button></div></section></div>`)}
function match(p){let a=S.answers,primary=a[1]?.value||a[0]?.value,top=a[0]?.value,form=a[2]?.value,detail=a[3]?.value,t=p.tags,score=0,why=[];if(!primary)return {score:-1,why};if(t.includes(primary)){score+=65;why.push(`对应您关注的「${a[1]?.label||a[0]?.label}」`)}else if(t.includes(top)){score+=25;why.push('与您选择的关注方向有关')}
 const fm={咨询:['咨询'],仪式:['传统仪式','法会','祈福'],物品:['实体物品'],事务:['风水','择日','开光'],学习:['学习'],食品:['食品']};if(form&&form!=='不限'){if((fm[form]||[]).some(x=>t.includes(x))){score+=30;why.push('符合您偏好的帮助形式')}else score-=45}
 if(detail&&detail!=='不限'){if(t.includes(detail)){score+=24;why.push('与进一步偏好相符')}else score-=12}
 if(budget&&!['不限','consult'].includes(budget)){let n=priceClass(p);if(budget==='high'){if(n!==null&&n<3000)score-=4}else if(n!==null&&n>Number(budget))return {score:-1,why};else if(n!==null)score+=5}
 if(budget==='consult'&&p.priceType==='consult')score+=6;
 // A universal cultural option, not an assertion of efficacy. Only surface when user has completed a meaningful path.
 if(p.subcategory==='符箓大类'){score=Math.max(score,49);why=['可作为进一步了解的传统符箓祈福选项；具体形式与适用方向需人工沟通确认']}
 if(primary==='求子'&&p.subcategory!=='符箓大类'&&!t.includes('求子'))score=-1;
 if(primary==='图鉴')score=-1;
 return {score,why}}
function matches(){if(!S.answers.length)return [];return P.map(p=>({p,...match(p)})).filter(x=>x.score>=49&&x.why.length).sort((a,b)=>b.score-a.score||a.p.id.localeCompare(b.p.id)).slice(0,3)}
function summary(){return S.answers.map((a,i)=>`${STAGES[i]}：${a.label}`).join('\n')||'尚未完成探索'}
function listItem(p){return `<button class="product-row" data-detail="${p.id}"><span>${escape(p.name)}</span><b>${escape(p.price)}${/^\d+$/.test(p.price)?' 元':''}</b></button>`}
function resultCard(x,i){let p=x.p;return `<article class="card"><p class="eyebrow">${i===0?'优先匹配':'其他可考虑'}</p><p class="chip">${escape(p.category)} / ${escape(p.subcategory)}</p><h3>${escape(p.name)}</h3><p class="price">${escape(p.price)}${/^\d+$/.test(p.price)?' 元':''}</p><p class="reason">根据您提供的信息，这项服务可能符合您的需求。${escape(x.why.join('；'))}。</p><div class="actions"><button data-detail="${p.id}">查看详细介绍</button><button data-consult="${p.id}">咨询这项服务</button></div></article>`}
function results(){let m=matches();header(`<div class="page-head"><p class="eyebrow">问心 · 寻解</p><h2>根据您的选择，我们找到了这些可能适合您的服务。</h2><p class="muted">推荐为初步信息匹配，不代表对结果的保证。</p></div><div class="result-grid"><aside class="summary"><h3>您的探索路径</h3><pre>${escape(summary())}</pre><button data-act="copy">复制我的需求摘要</button><button data-act="edit">修改选择</button></aside><section class="results">${m.length?m.map(resultCard).join(''):`<div class="empty"><h3>推荐进一步深入沟通</h3><p>目前信息不足以匹配具体服务。可以在群里，或联系曾曾、火火进一步沟通。</p></div>`}<div class="subactions"><button data-act="restart">重新探索</button><button data-act="catalog">查看其他服务</button></div></section></div>`)}
function catalog(){let q=S.query.trim().toLowerCase(),items=P.filter(p=>[p.name,p.category,p.subcategory,p.price,p.remark,p.description,...p.tags].join(' ').toLowerCase().includes(q));let cats=S.category?[S.category]:C;let content=cats.map(cat=>{let ps=items.filter(p=>p.category===cat);if(!ps.length)return '';let subs=[...new Set(ps.map(p=>p.subcategory))];return `<section class="catalog-cat"><button class="cat-heading" data-cat="${escape(cat)}"><span>${escape(cat)} <small>${ps.length} 项</small></span><span>${S.category===cat?'－':'＋'}</span></button>${S.category===cat?`<div class="subgroups">${subs.map(sub=>`<section class="subgroup"><button class="sub-heading" data-sub="${escape(sub)}">${escape(sub)} <small>${ps.filter(p=>p.subcategory===sub).length} 项</small> <span>${S.sub===sub?'－':'＋'}</span></button>${S.sub===sub?`<div class="products">${ps.filter(p=>p.subcategory===sub).map(listItem).join('')}</div>`:''}</section>`).join('')}</div>`:''}</section>`}).join('');header(`<div class="page-head"><p class="eyebrow">玉瑶司 · 服务图鉴</p><h2>一览所藏，按需寻访。</h2><p class="muted">${P.length} 项服务与产品 · 大类 → 子类 → 名称与价格；点击名称查看详情。</p></div><div class="toolbar"><input id="search" type="search" placeholder="搜索名称、分类或关键词" value="${escape(S.query)}"><button data-act="allcats">全部大类</button></div><div class="catalog-tree">${content||'<div class="empty">没有找到相关服务，请更换关键词。</div>'}</div><div class="subactions bottom"><button data-act="restart">返回需求探索</button><button data-act="compare">查看产品对比（${S.compare.length}/3）</button></div>`)}
function detail(){let p=P.find(x=>x.id===S.detail);if(!p){view('catalog');return}header(`<div class="page-head"><p class="eyebrow">服务详情 · ${escape(p.id)}</p><h2>${escape(p.name)}</h2><p class="muted">${escape(p.category)} / ${escape(p.subcategory)}</p></div><article class="detail"><p class="price">${escape(p.price)}${/^\d+$/.test(p.price)?' 元':''}</p><div class="detail-row"><b>详细描述</b><p>${escape(p.description)}</p></div><div class="detail-row"><b>备注 / 规格 / 服务条件</b><p>${escape(p.remark)}</p></div><div class="detail-row"><b>需求标签（依据描述整理，仅供导航）</b><p>${escape(p.tags.join('、')||'待补充')}</p></div><div class="actions"><button data-consult="${p.id}">咨询这项服务</button><button data-compare="${p.id}">${S.compare.includes(p.id)?'取消对比':'加入对比'}</button><button data-act="catalog">返回服务图鉴</button><button data-act="results">返回推荐</button></div></article>`)}
function consult(){let p=P.find(x=>x.id===S.detail);header(`<div class="page-head"><p class="eyebrow">进一步沟通</p><h2>把您的问题，带给我们。</h2></div><div class="detail"><p>意向服务：<b>${escape(p?.name||'尚未确定')}</b></p><pre>${escape(summary())}</pre><p>可以在群里，或者联系<strong>曾曾或火火</strong>进行进一步沟通。</p><p class="muted">本页面不提供联系方式，也不会自动上传您的选择。</p><div class="actions"><button data-act="copyconsult">复制咨询摘要</button><button data-act="catalog">查看全部服务</button><button data-act="results">返回推荐</button></div></div>`)}
function about(){header(`<div class="page-head"><p class="eyebrow">ABOUT · 玉瑶司</p><h2>先问心，再寻解。</h2></div><div class="detail"><p>「问心寻解」是玉瑶司的互动服务导航：从当前困惑出发，了解可能相关的实体产品、食品、咨询、课程、法会与开光服务。</p><p>如果希望进一步了解，可以在群里或者联系曾曾或火火沟通。本页面不公开联系方式。</p><p class="muted">服务描述保留原始提供文本，其中传统功效属于商家描述与文化信仰表述，不应被理解为经科学验证的效果承诺。食品及身心相关服务不替代医疗诊断或治疗。</p><button class="primary" data-act="start">开始探索</button></div>`)}
function compare(){let ps=S.compare.map(id=>P.find(p=>p.id===id)).filter(Boolean);header(`<div class="page-head"><h2>服务对比</h2><p class="muted">最多对比 3 项</p></div><div class="comparison">${ps.length?ps.map(p=>`<article class="card"><h3>${escape(p.name)}</h3><p class="chip">${escape(p.category)} / ${escape(p.subcategory)}</p><p class="price">${escape(p.price)}</p><p>${escape(p.description)}</p><button data-detail="${p.id}">查看详情</button><button data-compare="${p.id}">移除</button></article>`).join(''):'<p>请先在图鉴或详情页添加需要对比的服务。</p>'}</div><button data-act="catalog">返回服务图鉴</button>`)}
function copy(t){if(navigator.clipboard&&window.isSecureContext)navigator.clipboard.writeText(t).then(()=>alert('已复制')).catch(()=>fallback(t));else fallback(t)}function fallback(t){let el=document.createElement('textarea');el.value=t;document.body.append(el);el.select();try{document.execCommand('copy');alert('已复制')}catch{alert('请手动复制')}el.remove()}
function bind(){document.querySelectorAll('[data-act]').forEach(b=>b.addEventListener('click',()=>{let a=b.dataset.act;if(a==='home')view('home');else if(a==='start'||a==='restart')start();else if(a==='unsure'){start();choose('不确定','我不确定属于哪类')}else if(a==='explore')view('explore');else if(a==='edit')back(Math.max(0,S.answers.length-1));else if(a==='results')view('results');else if(a==='catalog')view('catalog');else if(a==='about')view('about');else if(a==='allcats'){S.category=null;S.sub=null;view('catalog')}else if(a==='compare')view('compare');else if(a==='copy')copy('玉瑶司 · 需求摘要\n'+summary());else if(a==='copyconsult'){let p=P.find(x=>x.id===S.detail);copy('玉瑶司 · 咨询摘要\n意向服务：'+(p?.name||'待确认')+'\n'+summary())}}));document.querySelectorAll('[data-choice]').forEach(b=>b.addEventListener('click',()=>{if(b.dataset.choice==='图鉴'){view('catalog');return}choose(b.dataset.choice,b.dataset.label)}));document.querySelectorAll('[data-back]').forEach(b=>b.addEventListener('click',()=>back(Number(b.dataset.back))));document.querySelectorAll('[data-cat]').forEach(b=>b.addEventListener('click',()=>{S.category=S.category===b.dataset.cat?null:b.dataset.cat;S.sub=null;render()}));document.querySelectorAll('[data-sub]').forEach(b=>b.addEventListener('click',()=>{S.sub=S.sub===b.dataset.sub?null:b.dataset.sub;render()}));document.querySelectorAll('[data-detail]').forEach(b=>b.addEventListener('click',()=>{S.detail=b.dataset.detail;view('detail')}));document.querySelectorAll('[data-consult]').forEach(b=>b.addEventListener('click',()=>{S.detail=b.dataset.consult;view('consult')}));document.querySelectorAll('[data-compare]').forEach(b=>b.addEventListener('click',()=>{let id=b.dataset.compare;if(S.compare.includes(id))S.compare=S.compare.filter(x=>x!==id);else if(S.compare.length<3)S.compare.push(id);else{alert('最多对比3项');return}render()}));let input=$('#search');if(input)input.addEventListener('input',()=>{let pos=input.selectionStart;S.query=input.value;catalog();let next=$('#search');next.focus();next.setSelectionRange(pos,pos)})}
function render(){persist();({home,explore,results,catalog,detail,consult,about,compare}[S.view]||home)();window.scrollTo(0,0)}
try{let saved=JSON.parse(sessionStorage.getItem('yy_v2'));if(saved&&Array.isArray(saved.answers)&&Number.isInteger(saved.step)&&saved.step>=0&&saved.step<=4)S={...S,...saved}}catch{}
window.YY_APP={products:P,matches,start,render,ROOT,SUB};render();
})();


:: Start
<div id="app"></div>
